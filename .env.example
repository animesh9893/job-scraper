# Apify Console → Settings → API & Integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxx

# Supabase → Project → Connect → "Session pooler" connection string (works over IPv4, needed for GitHub Actions)
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Optional: Telegram alerts (README → Telegram job alerts). From @BotFather.
TELEGRAM_BOT_TOKEN=
# Any 16+ random letters/digits/_/-; the same value goes in Vercel and GitHub
TELEGRAM_WEBHOOK_SECRET=
